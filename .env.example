# environment backend 
# salin file ini menjadi .env untuk menjalankan api dan worker secara lokal.
# nama variabel harus tetap huruf besar karena aplikasi membacanya dengan nama ini.
# jangan pernah memasukkan nilai rahasia asli ke file ini.

# -----------------------------------------------------------------------------
# aplikasi api
# -----------------------------------------------------------------------------

# digunakan oleh apps/api/src/main.ts untuk menentukan mode aplikasi.
NODE_ENV=development

# digunakan oleh apps/api/src/main.ts sebagai port server http.
PORT=3000

# digunakan oleh apps/api/src/main.ts untuk origin cors.
# isi beberapa origin dengan koma tanpa spasi.
CORS_ORIGINS=http://localhost:5173

# digunakan oleh libs/platform/src/platform.module.ts.
# keduanya opsional. Gunakan untuk rate limiting global di api. 
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# -----------------------------------------------------------------------------
# database postgresql
# -----------------------------------------------------------------------------

# digunakan oleh prisma cli dan sebagai fallback untuk layanan database read/write.
# untuk lokal, nilainya dapat sama dengan database write.
DATABASE_URL=postgresql://user:password@localhost:5432/pos?schema=public

# digunakan oleh prisma schema dan prismawriteservice untuk checkout, stok,
# pembayaran, job ai, serta seluruh operasi tulis.
DATABASE_URL_WRITE=postgresql://user:password@localhost:5432/pos?schema=public

# digunakan oleh prismareadservice untuk dashboard, reporting, dan query baca.
# gunakan read replica di staging/production. untuk lokal dapat menunjuk database yang sama.
DATABASE_URL_READ_REPLICA=postgresql://user:password@localhost:5432/pos?schema=public

# -----------------------------------------------------------------------------
# redis dan observability
# -----------------------------------------------------------------------------

# digunakan oleh reportingcacheservice untuk cache dashboard dan distributed lock.
# bila kosong, aplikasi tetap berjalan dengan cache memory per instance.
REDIS_URL=redis://localhost:6379

# digunakan oleh metricsauthguard untuk melindungi endpoint /metrics dengan basic auth.
# isi keduanya di staging dan production. bila keduanya kosong, /metrics tidak memakai basic auth.
METRICS_AUTH_USER=monitor
METRICS_AUTH_PASSWORD=change-this-metrics-password

# digunakan oleh judoscale-express pada api untuk mengirim metrik autoscaling.
# kosongkan bila judoscale tidak digunakan.
JUDOSCALE_URL=

# digunakan oleh judoscale-express untuk detail log reporter.
# nilai yang umum digunakan adalah info atau debug.
JUDOSCALE_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# autentikasi
# -----------------------------------------------------------------------------

# digunakan oleh jwtstrategy dan tokenservice untuk membuat serta memverifikasi access token.
# gunakan string acak yang panjang dan berbeda pada setiap environment.
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret

# digunakan oleh tokenservice untuk masa berlaku access token.
JWT_ACCESS_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# provider ai insight
# -----------------------------------------------------------------------------

# digunakan oleh llminsightadapter untuk endpoint provider ai kompatibel openai.
# bila url atau api key kosong, checkout dan dashboard tetap berjalan, tetapi job insight akan gagal.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=

# digunakan oleh llminsightadapter untuk model yang dipanggil provider ai.
AI_PROVIDER_MODEL=gpt-4.1-mini

# digunakan oleh llminsightadapter sebagai timeout satu request ai dalam milidetik.
AI_PROVIDER_TIMEOUT_MS=15000

# digunakan oleh llminsightadapter sebagai jumlah maksimum percobaan request ai.
AI_PROVIDER_MAX_ATTEMPTS=2

# digunakan oleh llminsightadapter untuk membuka circuit breaker setelah sejumlah kegagalan.
AI_PROVIDER_BREAKER_THRESHOLD=3

# digunakan oleh llminsightadapter sebagai waktu tunggu circuit breaker dalam milidetik.
AI_PROVIDER_BREAKER_COOLDOWN_MS=30000

# -----------------------------------------------------------------------------
# worker ai
# -----------------------------------------------------------------------------

# digunakan oleh aianalysisscheduler untuk membatasi job yang diambil setiap tick.
AI_WORKER_MAX_JOBS_PER_TICK=5

# digunakan oleh aianalysisscheduler untuk membatasi request ai paralel.
AI_WORKER_CONCURRENCY=5

# digunakan oleh insightgenerationservice sebagai jumlah maksimum retry job ai.
AI_JOB_MAX_ATTEMPTS=3

# digunakan oleh insightgenerationservice sebagai jeda retry awal dalam milidetik.
AI_JOB_RETRY_BASE_DELAY_MS=60000

# digunakan oleh aianalysisjobrepository untuk mengambil ulang job processing
# yang ditinggalkan worker setelah durasi ini dalam milidetik.
AI_JOB_LEASE_TIMEOUT_MS=900000
