# ============================================================
# Contoh environment backend (Nest monorepo). Salin ke `.env`:
#   Copy-Item .env.example .env
# JANGAN commit `.env` ke git (sudah di-ignore).
# ============================================================

# ---- PostgreSQL (Neon) ----
# `DATABASE_URL_WRITE` dipakai CLI Prisma (migrate/generate) & PrismaWriteService
# (primary). `DATABASE_URL_READ` dipakai PrismaReadService (read replica). Di
# Railway: set kedua variabel ini sebagai variabel service (lihat 05 §4).
DATABASE_URL_WRITE=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pos_production?sslmode=require
DATABASE_URL_READ=postgresql://user:password@ep-example-ro.region.aws.neon.tech/pos_production?sslmode=require

# ---- App ----
NODE_ENV=development
PORT=3000
# Daftar origin yang diizinkan CORS (koma), mis. frontend Vite/React
CORS_ORIGINS=http://localhost:5173

# ---- Auth (identity) ----
# Nama variabel sesuaikan implementasi AuthService di libs/identity.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- AI provider eksternal (opsional, EXT-AI-003 / 05:798) ----
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=

# ---- Observability ----
# Endpoint /metrics (prom-client) otomatis aktif via @willsoto/nestjs-prometheus
# PROMETHEUS_SCRAPE_INTERVAL_MS=15000
