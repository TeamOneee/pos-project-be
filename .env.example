# ============================================================
# Contoh environment backend (Nest monorepo). Salin ke `.env`:
#   Copy-Item .env.example .env
# JANGAN commit `.env` ke git (sudah di-ignore).
# ============================================================

# ---- PostgreSQL (Database Primary & Read Replica) ----
# `DATABASE_URL` / `DATABASE_URL_WRITE`: Database Primary (Write, checkout, mutasi, Prisma CLI)
# `DATABASE_URL_READ_REPLICA`: Database Read Replica (Read-only analitik, reporting, dashboard).
# Jika `DATABASE_URL_READ_REPLICA` tidak diset/kosong, reporting otomatis menunjuk ke Primary (`DATABASE_URL`).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pos_production?sslmode=require
DATABASE_URL_WRITE=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pos_production?sslmode=require
DATABASE_URL_READ_REPLICA=postgresql://user:password@ep-example-ro.region.aws.neon.tech/pos_production?sslmode=require

# ---- Redis (Cache-Aside & Distributed Lock) ----
# Diperlukan untuk multi-instance cache and single-flight lock
REDIS_URL=redis://localhost:6379

# ---- App ----
NODE_ENV=development
PORT=3000
# Daftar origin yang diizinkan CORS (koma), mis. frontend Vite/React
CORS_ORIGINS=http://localhost:5173

# ---- Auth (identity) ----
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
# Reserved untuk iterasi mendatang jika refresh token diaktifkan:
# JWT_REFRESH_SECRET=change-me
# JWT_REFRESH_EXPIRES_IN=30d

# ---- AI provider eksternal (LLM insight) ----
# endpoint kompatibel OpenAI chat completions; worker akan menandai job FAILED
# bila URL atau API key belum diisi, tanpa mengganggu checkout/dashboard.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4.1-mini
AI_PROVIDER_TIMEOUT_MS=15000
# perlindungan singkat per panggilan LLM; retry job tetap menjadi mekanisme recovery utama.
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_BREAKER_THRESHOLD=3
AI_PROVIDER_BREAKER_COOLDOWN_MS=30000

# ---- AI worker ----
# job tetap dibatasi per polling agar workload AI tidak mengambil resource checkout.
AI_WORKER_MAX_JOBS_PER_TICK=5
# retry terjadi pada level job dengan exponential backoff, bukan di dalam request LLM.
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_DELAY_MS=60000

# ---- Observability ----
# Endpoint /metrics (prom-client) otomatis aktif via @willsoto/nestjs-prometheus
# PROMETHEUS_SCRAPE_INTERVAL_MS=15000
