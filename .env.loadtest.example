# Salin file ini menjadi .env.loadtest lalu isi sesuai environment kamu:
#   cp .env.loadtest.example .env.loadtest
# Nilai di bawah ini adalah default lokal (Docker Postgres pos_loadtest di localhost:55432).

# Prisma write / transaksi (primary)
DATABASE_URL="postgresql://pos:pos@localhost:55432/pos_loadtest?connection_limit=10"
# alias write (opsional, sama dengan DATABASE_URL kalau tidak pakai multi-URL)
DATABASE_URL_WRITE="postgresql://pos:pos@localhost:55432/pos_loadtest?connection_limit=10"
# read replica — selama belum ada replica, isi SAMA dengan primary
DATABASE_URL_READ_REPLICA="postgresql://pos:pos@localhost:55432/pos_loadtest?connection_limit=10"

# Auth untuk seed/request (bukan rahasia produksi)
JWT_ACCESS_SECRET="loadtest-secret"
JWT_ACCESS_EXPIRES_IN=2h

# Matikan rate-limit agar tidak mempengaruhi pengukuran
THROTTLE_LIMIT=1000000
THROTTLE_TTL_MS=60000

# Port API load test (hindari bentrok dengan dev server :3000)
PORT=3001
NODE_ENV=test