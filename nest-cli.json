{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "monorepo": true,
  "root": "apps/api",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    },
    "platform": {
      "type": "library",
      "root": "libs/platform",
      "entryFile": "index",
      "sourceRoot": "libs/platform/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform/tsconfig.lib.json"
      }
    },
    "identity": {
      "type": "library",
      "root": "libs/identity",
      "entryFile": "index",
      "sourceRoot": "libs/identity/src",
      "compilerOptions": {
        "tsConfigPath": "libs/identity/tsconfig.lib.json"
      }
    },
    "tenant": {
      "type": "library",
      "root": "libs/tenant",
      "entryFile": "index",
      "sourceRoot": "libs/tenant/src",
      "compilerOptions": {
        "tsConfigPath": "libs/tenant/tsconfig.lib.json"
      }
    },
    "catalog": {
      "type": "library",
      "root": "libs/catalog",
      "entryFile": "index",
      "sourceRoot": "libs/catalog/src",
      "compilerOptions": {
        "tsConfigPath": "libs/catalog/tsconfig.lib.json"
      }
    },
    "inventory": {
      "type": "library",
      "root": "libs/inventory",
      "entryFile": "index",
      "sourceRoot": "libs/inventory/src",
      "compilerOptions": {
        "tsConfigPath": "libs/inventory/tsconfig.lib.json"
      }
    },
    "sales": {
      "type": "library",
      "root": "libs/sales",
      "entryFile": "index",
      "sourceRoot": "libs/sales/src",
      "compilerOptions": {
        "tsConfigPath": "libs/sales/tsconfig.lib.json"
      }
    },
    "reporting": {
      "type": "library",
      "root": "libs/reporting",
      "entryFile": "index",
      "sourceRoot": "libs/reporting/src",
      "compilerOptions": {
        "tsConfigPath": "libs/reporting/tsconfig.lib.json"
      }
    },
    "insight": {
      "type": "library",
      "root": "libs/insight",
      "entryFile": "index",
      "sourceRoot": "libs/insight/src",
      "compilerOptions": {
        "tsConfigPath": "libs/insight/tsconfig.lib.json"
      }
    }
  }
}
